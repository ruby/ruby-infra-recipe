resource "fastly_service_vcl" "archive" {
  activate           = true
  stage              = false
  default_ttl        = 3600
  http3              = true
  name               = "archive.ruby-lang.org"
  stale_if_error     = true
  stale_if_error_ttl = 43200

  backend {
    address               = "blade.ruby-lang.org.s3-ap-northeast-1.amazonaws.com"
    auto_loadbalance      = false
    between_bytes_timeout = 10000
    connect_timeout       = 1000
    error_threshold       = 0
    first_byte_timeout    = 15000
    keepalive_time        = 0
    max_conn              = 200
    max_lifetime          = 0
    max_use               = 0
    name                  = "Origin s3 bucket"
    override_host         = "blade.ruby-lang.org.s3-ap-northeast-1.amazonaws.com"
    port                  = 80
    prefer_ipv6           = false
    shield                = "tyo-tokyo-jp"
    ssl_check_cert        = true
    use_ssl               = false
    weight                = 100
  }

  domain {
    name = "archive.ruby-lang.org"
  }

  gzip {
    content_types = ["text/html", "application/x-javascript", "text/css", "application/javascript", "text/javascript", "application/json", "application/vnd.ms-fontobject", "application/x-font-opentype", "application/x-font-truetype", "application/x-font-ttf", "application/xml", "font/eot", "font/opentype", "font/otf", "image/svg+xml", "image/vnd.microsoft.icon", "text/plain", "text/xml"]
    extensions    = ["css", "js", "html", "eot", "ico", "otf", "ttf", "json", "svg"]
    name          = "Generated by default gzip policy"
  }

  header {
    action        = "set"
    destination   = "http.Content-Type"
    ignore_if_set = false
    name          = "Add Content Type"
    priority      = 10
    source        = "\"text/plain; charset=utf-8\""
    type          = "cache"
  }

  logging_datadog {
    format            = file("${path.module}/logging/datadog_format.json")
    format_version    = 2
    name              = "Datadog"
    processing_region = "none"
    region            = "AP1"
    token             = var.datadog_token
  }
}
